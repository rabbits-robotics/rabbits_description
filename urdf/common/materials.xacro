<?xml version="1.0"?>
<!-- 機体をまたいで使う色の定義 -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="rabbits_grey">
    <color rgba="0.55 0.55 0.6 1.0" />
  </material>
  <material name="rabbits_blue">
    <color rgba="0.2 0.4 0.9 1.0" />
  </material>
  <material name="rabbits_orange">
    <color rgba="0.95 0.55 0.1 1.0" />
  </material>
  <material name="rabbits_dark">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>
  <!-- 部品の種類ごとの色分け用。Fusion 360 のコンポーネント色循環のような淡い色 -->
  <material name="rabbits_pale_blue">
    <color rgba="0.60 0.76 0.93 1.0" />
  </material>
  <material name="rabbits_pale_green">
    <color rgba="0.66 0.85 0.66 1.0" />
  </material>
  <material name="rabbits_pale_orange">
    <color rgba="0.96 0.80 0.56 1.0" />
  </material>
  <material name="rabbits_pale_purple">
    <color rgba="0.80 0.72 0.90 1.0" />
  </material>
  <material name="rabbits_pale_yellow">
    <color rgba="0.95 0.90 0.62 1.0" />
  </material>
  <material name="rabbits_pale_grey">
    <color rgba="0.78 0.78 0.80 1.0" />
  </material>
  <material name="rabbits_mid_grey">
    <color rgba="0.35 0.35 0.38 1.0" />
  </material>
</robot>
