<?xml version="1.0"?>
<!--
  gamma の脚 1 本 + 車輪（4 節リンク、実寸。設計書 rabcl docs/superpowers/specs/2026-10-25-gamma-leg-linkage-design.md 7 章）。
  寸法は config/gamma_linkage.yaml（引数 L）。見た目は箱と円筒（メッシュは後で差し替え）。

  脚の面内 2 次元: 関節フレームは z 回りに方位角 azimuth だけ回し、x = 半径方向の外向き、z = 上。
  回転軸はすべて +y（正の回転は x から −z へ = 下向き）。
    base_link
     ├─ <p>_leg_joint   （M、θ = joint_states の脚モータ角。0 = 車高が最も低い）→ crank_link
     │    └─ <p>_coupler_joint（K、派生: −(ψ − α)）→ coupler_link（連結リンク。先端 J は閉じない = ループをここで切る）
     ├─ <p>_bar_joint   （B1、派生: −φ）→ bar_link（上のバー）
     │    └─ <p>_holder_joint（H1、mimic bar × −1）→ holder_link（車輪ホルダ。胴体と平行を保つ）
     │         └─ <p>_wheel_joint（W、車輪の z = 半径方向の外向き）→ wheel
     └─ <p>_bar_lower_joint（B2、mimic bar × 1）→ bar_lower_link（下のバー）
  派生関節（bar、coupler）は linkage_state_publisher が rabcl::LegLinkage で計算して joint_states に足す。
  クランクの向きは α = α0 − θ なので、クランクと連結リンクの visual は自分のフレームで +x から α0 上を向く。
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="gamma_leg" params="prefix azimuth L">
    <xacro:property name="a0" value="${L['crank_angle_zero']}" />
    <xacro:property name="Lc" value="${L['crank_length']}" />
    <xacro:property name="Lr" value="${L['coupler_length']}" />
    <xacro:property name="Lb" value="${L['bar_length']}" />
    <xacro:property name="arm_r" value="0.006" />

    <!-- クランク（脚モータの出力） -->
    <joint name="${prefix}_leg_joint" type="revolute">
      <parent link="base_link" />
      <child link="${prefix}_crank_link" />
      <origin xyz="${L['leg_radius'] * cos(azimuth)} ${L['leg_radius'] * sin(azimuth)} 0" rpy="0 0 ${azimuth}" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="${L['theta_max']}" effort="10" velocity="5" />
    </joint>
    <link name="${prefix}_crank_link">
      <visual>
        <origin xyz="${Lc / 2 * cos(a0)} 0 ${Lc / 2 * sin(a0)}" rpy="0 ${pi / 2 - a0} 0" />
        <geometry>
          <cylinder radius="${arm_r}" length="${Lc}" />
        </geometry>
        <material name="rabbits_blue" />
      </visual>
    </link>

    <!-- 連結リンク（クランク先端 K にぶら下がる。先端 J はホルダに重なって見えるだけ） -->
    <joint name="${prefix}_coupler_joint" type="revolute">
      <parent link="${prefix}_crank_link" />
      <child link="${prefix}_coupler_link" />
      <origin xyz="${Lc * cos(a0)} 0 ${Lc * sin(a0)}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="${-pi}" upper="${pi}" effort="0" velocity="10" />
    </joint>
    <link name="${prefix}_coupler_link">
      <visual>
        <origin xyz="${Lr / 2 * cos(a0)} 0 ${Lr / 2 * sin(a0)}" rpy="0 ${pi / 2 - a0} 0" />
        <geometry>
          <cylinder radius="${arm_r}" length="${Lr}" />
        </geometry>
        <material name="rabbits_dark" />
      </visual>
    </link>

    <!-- 上のバー（派生関節。バーのフレームでは +x 向き） -->
    <joint name="${prefix}_bar_joint" type="revolute">
      <parent link="base_link" />
      <child link="${prefix}_bar_link" />
      <origin xyz="${(L['leg_radius'] + L['bar_pivot'][0]) * cos(azimuth)} ${(L['leg_radius'] + L['bar_pivot'][0]) * sin(azimuth)} ${L['bar_pivot'][1]}"
              rpy="0 0 ${azimuth}" />
      <axis xyz="0 1 0" />
      <limit lower="${-pi}" upper="${pi}" effort="0" velocity="10" />
    </joint>
    <link name="${prefix}_bar_link">
      <visual>
        <origin xyz="${Lb / 2} 0 0" rpy="0 ${pi / 2} 0" />
        <geometry>
          <cylinder radius="${arm_r}" length="${Lb}" />
        </geometry>
        <material name="rabbits_grey" />
      </visual>
    </link>

    <!-- 下のバー（上のバーと同じ角度） -->
    <joint name="${prefix}_bar_lower_joint" type="revolute">
      <parent link="base_link" />
      <child link="${prefix}_bar_lower_link" />
      <origin xyz="${(L['leg_radius'] + L['bar_pivot_lower'][0]) * cos(azimuth)} ${(L['leg_radius'] + L['bar_pivot_lower'][0]) * sin(azimuth)} ${L['bar_pivot_lower'][1]}"
              rpy="0 0 ${azimuth}" />
      <axis xyz="0 1 0" />
      <limit lower="${-pi}" upper="${pi}" effort="0" velocity="10" />
      <mimic joint="${prefix}_bar_joint" multiplier="1" offset="0" />
    </joint>
    <link name="${prefix}_bar_lower_link">
      <visual>
        <origin xyz="${Lb / 2} 0 0" rpy="0 ${pi / 2} 0" />
        <geometry>
          <cylinder radius="${arm_r}" length="${Lb}" />
        </geometry>
        <material name="rabbits_grey" />
      </visual>
    </link>

    <!-- ホルダ: 上のバーの先 H1。バーと逆に回って胴体と平行を保つ。J（上端ピン）と W（車輪中心）を含む -->
    <joint name="${prefix}_holder_joint" type="revolute">
      <parent link="${prefix}_bar_link" />
      <child link="${prefix}_holder_link" />
      <origin xyz="${Lb} 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="${-pi}" upper="${pi}" effort="0" velocity="10" />
      <mimic joint="${prefix}_bar_joint" multiplier="-1" offset="0" />
    </joint>
    <link name="${prefix}_holder_link">
      <visual>
        <origin xyz="${L['wheel'][0] / 2} 0 ${(L['coupler_pin'][1] + L['wheel'][1]) / 2}" rpy="0 0 0" />
        <geometry>
          <box size="${L['wheel'][0]} 0.02 ${L['coupler_pin'][1] - L['wheel'][1]}" />
        </geometry>
        <material name="rabbits_blue" />
      </visual>
    </link>

    <!-- 車輪: z 軸が回転軸、z 正が機体の外側（ホルダの x = 半径方向外向き を z に向ける） -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_holder_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="${L['wheel'][0]} 0 ${L['wheel'][1]}" rpy="0 ${pi / 2} 0" />
      <axis xyz="0 0 1" />
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${L['wheel_radius']}" length="${L['wheel_width']}" />
        </geometry>
        <material name="rabbits_dark" />
      </visual>
    </link>
  </xacro:macro>
</robot>
