<?xml version="1.0"?>
<!-- gamma の胴体（meshes/gamma/base.STL、mm、原点 = 脚モータ軸の水平面 × Yaw 軸、x 前・y 左・z 上）。
     collision 用の箱は仮（center_z は脚モータ軸の面からの中心のずれ） -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="gamma_body" params="size_xy height center_z">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://rabbits_description/meshes/gamma/base.STL" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="rabbits_pale_yellow" />
      </visual>
      <collision>
        <origin xyz="0 0 ${center_z}" rpy="0 0 0" />
        <geometry>
          <box size="${size_xy} ${size_xy} ${height}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
